# Conexão PostgreSQL (local ou Supabase: Project Settings > Database > Connection string)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/prospeccao
# Use "true" para Supabase / bancos gerenciados com SSL
DATABASE_SSL=false
# "true" ao usar o pooler do Supabase (porta 6543): menos conexões por instância e sem parâmetros de sessão
DATABASE_POOLER=false

# Usuários autorizados (login básico do MVP): usuario:senha separados por vírgula.
# Em produção, troque por senhas fortes ou migre para Supabase Auth.
APP_USERS=comercial:troque-esta-senha
