GOOGLE_PLACES_API_KEY=
PLACES_MAX_CALLS_PER_RUN=300
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SCRAPER_USER_AGENT="ProspectorFrotas/0.1 (contato: email@empresa.com.br)"
CACHE_TTL_DAYS=30
# Base CNPJ: listagem com uma pasta por mês contendo os zips.
# Oficial: https://arquivos.receitafederal.gov.br/dados/cnpj/dados_abertos_cnpj/ (bloqueia IPs fora do Brasil)
# Espelho (default): https://dados-abertos-rf-cnpj.casadosdados.com.br/arquivos/
RECEITA_BASE_URL=https://dados-abertos-rf-cnpj.casadosdados.com.br/arquivos/
# Opcional: força um mês (AAAA-MM ou AAAA-MM-DD). Vazio = mais recente.
RECEITA_MES=
